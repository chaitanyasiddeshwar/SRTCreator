# Build output
/build/
/out/
/dist/

# Downloaded models (large; fetched on demand)
/models/
*.bin
*.gguf

# Vendored FFmpeg dev/shared libs (provided locally, not committed)
/third_party/ffmpeg/

# ONNX Runtime (DirectML) - provided locally, not committed (large binaries)
/third_party/onnxruntime/

# Prebuilt whisper backend-DL DLL set - mirrored locally / fetched in CI (large),
# produced by scripts/build-whisper-dlls.ps1; not committed.
/third_party/whisper/

# whisper deps-build tree (CUDA/Vulkan compile output, multi-GB)
/build-whisper-dlls/

# Python bytecode cache
__pycache__/

# Claude Code local runtime state (machine-local; not shared)
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Editor / OS cruft
.vscode/
.idea/
*.user
Thumbs.db
Desktop.ini

# Local scratch
*.log
*.srt
