+// map a time (centiseconds) from the VAD-processed timeline back to the original
+// audio. A time inside a speech segment is interpolated within that segment;
+// a time falling in the silence removed between two segments (a silence bridge inserted by VAD):
+//   - If is_start is true (e.g. t0 of a segment or token): it belongs to the upcoming speech segment,
+//     so it snaps forward to segs[i + 1].orig_start. Snapping backward across the removed silence gap
+//     would cause cues to jump tens of seconds early!
+//   - If is_start is false (e.g. t1 of a segment or token): it belongs to the preceding speech segment,
+//     so it snaps backward to s.orig_end.
+static int64_t whisper_map_token_time_segment_aware(
+        int64_t t,
+        const std::vector<whisper_state::vad_segment_info> & segs,
+        bool is_start) {
+    if (segs.empty()) {
+        return t;
+    }
+    if (t <= segs.front().vad_start) {
+        return segs.front().orig_start;
+    }
+    if (t >= segs.back().vad_end) {
+        return segs.back().orig_end;
+    }
+    for (size_t i = 0; i < segs.size(); ++i) {
+        const auto & s = segs[i];
+        if (t >= s.vad_start && t <= s.vad_end) {
+            const int64_t vd = s.vad_end - s.vad_start;
+            const int64_t od = s.orig_end - s.orig_start;
+            if (vd <= 0) {
+                return s.orig_start;
+            }
+            return s.orig_start + (t - s.vad_start) * od / vd;
+        }
+        if (i + 1 < segs.size() && t > s.vad_end && t < segs[i + 1].vad_start) {
+            return is_start ? segs[i + 1].orig_start : s.orig_end;
+        }
+    }
+    return t;
+}
